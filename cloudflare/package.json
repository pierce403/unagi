{
  "name": "unagi-ninja-hosting",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-site.mjs && node cloudflare-assets.mjs && CLOUDFLARE_ASSET_DIRECTORY=../dist node split-large-assets.mjs && node check-types.mjs",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "check:deploy": "npm run build && wrangler deploy --config ../wrangler.jsonc --dry-run",
    "test:hosting": "node verify-large-asset.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.151.0",
    "typescript": "5.9.3"
  }
}
